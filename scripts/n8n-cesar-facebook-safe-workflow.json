      "parameters": {
        "jsCode": "const PAGE_ID = '733722713158762';\nconst event = $json.body?.entry?.[0]?.messaging?.[0] || {};\nconst message = event.message || {};\nconst messageText = typeof message.text === 'string' ? message.text.trim() : '';\nconst senderId = event.sender?.id || '';\nconst recipientId = event.recipient?.id || '';\nconst messageId = message.mid || `${senderId}:${event.timestamp || ''}:${messageText}`;\nlet shouldProcess = true;\nlet reason = 'ok';\n\nif ($json.body?.object !== 'page') {\n  shouldProcess = false;\n  reason = 'not_page_object';\n} else if (!senderId || !recipientId) {\n  shouldProcess = false;\n  reason = 'missing_sender_or_recipient';\n} else if (!messageText) {\n  shouldProcess = false;\n  reason = 'empty_or_non_text_message';\n} else if (message.is_echo) {\n  shouldProcess = false;\n  reason = 'echo_message';\n} else if (senderId === PAGE_ID) {\n  shouldProcess = false;\n  reason = 'page_sent_message';\n}\n\nconst now = Date.now();\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seenMessages = staticData.seenMessages || {};\nstaticData.senderRate = staticData.senderRate || {};\nstaticData.pageRate = staticData.pageRate || [];\n\nfor (const [key, seenAt] of Object.entries(staticData.seenMessages)) {\n  if (now - Number(seenAt) > 24 * 60 * 60 * 1000) {\n    delete staticData.seenMessages[key];\n  }\n}\n\nif (shouldProcess && staticData.seenMessages[messageId]) {\n  shouldProcess = false;\n  reason = 'duplicate_message';\n}\n\nif (shouldProcess) {\n  staticData.seenMessages[messageId] = now;\n}\n\nif (shouldProcess) {\n  const senderWindowMs = 10 * 60 * 1000;\n  const senderEvents = (staticData.senderRate[senderId] || []).filter((time) => now - time < senderWindowMs);\n  senderEvents.push(now);\n  staticData.senderRate[senderId] = senderEvents;\n\n  if (senderEvents.length > 5) {\n    shouldProcess = false;\n    reason = 'sender_rate_limited';\n  }\n}\n\nif (shouldProcess) {\n  const pageWindowMs = 60 * 1000;\n  const pageEvents = (staticData.pageRate || []).filter((time) => now - time < pageWindowMs);\n  pageEvents.push(now);\n  staticData.pageRate = pageEvents;\n\n  if (pageEvents.length > 30) {\n    shouldProcess = false;\n    reason = 'page_rate_limited';\n  }\n}\n\nreturn [\n  {\n    json: {\n      shouldProcess,\n      reason,\n      senderId,\n      recipientId,\n      messageId,\n      messageText,\n      lang: /[\\u0600-\\u06ff]/.test(messageText) ? 'ar' : 'en'\n    }\n  }\n];"
      },
